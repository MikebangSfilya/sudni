TELEGRAM_BOT_TOKEN=123456:replace_me
# Основной пресет: DeepSeek через OpenRouter. Также доступны openai и deepseek.
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Для встроенных провайдеров пустые значения означают безопасные пресеты.
LLM_BASE_URL=
LLM_MODEL=
# Необязательная атрибуция приложения в OpenRouter
LLM_APP_URL=
LLM_APP_NAME=Судный день
LLM_ENABLED=true
LLM_MIN_MESSAGES=3
LLM_MAX_INPUT_CHARS=200000
LLM_TIMEOUT_SECONDS=45
LLM_MAX_DELTA=3
LLM_MIN_CONFIDENCE=0.6
LLM_POST_HOLDS=true
LLM_MAX_CONCURRENCY=3
BOT_TIMEZONE=Europe/Moscow
REVIEW_INTERVAL_SECONDS=3600
DAILY_POST_HOUR=9
DAILY_POST_MINUTE=0
LOG_LEVEL=INFO
